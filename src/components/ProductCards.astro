---
import { Image } from "astro:assets";
import jejakHero from "../assets/jejakbahagia_hero.png";
import sekulahHero from "../assets/sekulah_hero.png";
import desgoHero from "../assets/desgo_hero.png";
import sobatHero from "../assets/SobatDeadline.png";

const products = [
    {
        index: "01",
        name: "Jejak Bahagia",
        category: "WEDDING TECH",
        description:
            "Platform undangan pernikahan digital elegan & responsif dengan RSVP real-time, buku tamu, dan galeri multimedia HD.",
        url: "https://jejakbahagia.com",
        image: jejakHero,
    },
    {
        index: "02",
        name: "Sekulah",
        category: "EDUTECH",
        description:
            "Sistem website sekolah modern dan terintegrasi portal SPMB online mandiri serta publikasi profil & agenda akademik.",
        url: "https://sekulah.pages.dev",
        image: sekulahHero,
    },
    {
        index: "03",
        name: "Desgo",
        category: "GOVTECH",
        description:
            "Sistem informasi desa dan digitalisasi tata kelola administrasi untuk kemudahan pelayanan publik warga secara mandiri.",
        url: "https://desgo.pages.dev",
        image: desgoHero,
    },
    {
        index: "04",
        name: "Sobat Deadline",
        category: "ACADEMIC SERVICES",
        description:
            "Layanan pendampingan akademik komprehensif: asistensi skripsi, riset makalah ilmiah, olah data, dan desain presentasi.",
        url: "https://sobatdeadline.pages.dev",
        image: sobatHero,
    },
];
---

<section id="produk" class="py-16 sm:py-24 bg-[#f8fafc] border-b border-[#e2e8f0]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        {/* Section Header */}
        <div class="flex flex-col md:flex-row md:items-end justify-between pb-8 mb-10 border-b border-[#e2e8f0] gap-4">
            <div class="space-y-2">
                <div class="text-xs font-mono text-[#0084ff] uppercase tracking-[0.2em] font-bold">
                    // 01 KATALOG PLATFORM
                </div>
                <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-[#031b4d] uppercase">
                    Solusi Terintegrasi
                </h2>
                <p class="text-[#5b6777] text-sm leading-relaxed max-w-xl">
                    Ekosistem aplikasi mandiri dengan fokus performa, reliabilitas, dan kemudahan akses.
                </p>
            </div>
            <div class="text-xs font-mono text-[#5b6777] uppercase tracking-wider flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-[#0084ff]"></span>
                <span>[ 04 PLATFORM ]</span>
            </div>
        </div>

        {/* Simplified Swiss Grid: 3 Columns on lg: */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {
                products.map((product) => (
                    <a
                        href={product.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-white border border-[#e2e8f0] rounded-sm overflow-hidden flex flex-col transition-all duration-300 hover:border-[#0084ff] hover:shadow-lg hover:-translate-y-1"
                    >
                        {/* Clean Image Viewport */}
                        <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 border-b border-[#e2e8f0]">
                            <Image
                                src={product.image}
                                alt={product.name}
                                width={700}
                                height={440}
                                class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
                            />
                        </div>

                        {/* Clean Minimalist Body */}
                        <div class="p-6 flex flex-col flex-grow justify-between gap-4">
                            <div class="space-y-2">
                                <div class="flex items-center justify-between text-xs font-mono">
                                    <span class="text-[#5b6777]">{product.index} //</span>
                                    <span class="text-[#0084ff] font-bold tracking-wider">{product.category}</span>
                                </div>
                                <h3 class="text-xl font-bold text-[#031b4d] tracking-tight group-hover:text-[#0084ff] transition-colors flex items-center justify-between">
                                    <span>{product.name}</span>
                                    <span class="text-sm font-mono text-[#5b6777] transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[#0084ff]">&nearr;</span>
                                </h3>
                                <p class="text-xs sm:text-sm text-[#5b6777] leading-relaxed">
                                    {product.description}
                                </p>
                            </div>

                            {/* Minimal Action Footer */}
                            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-mono text-[#031b4d]">
                                <span class="text-[#5b6777] text-[11px]">Akses Langsung</span>
                                <span class="text-[#0084ff] font-semibold group-hover:underline flex items-center gap-1">
                                    Buka Platform &rarr;
                                </span>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>

{/* Swiss Philosophy / About Section */}
<section id="tentang" class="py-16 sm:py-24 bg-white border-b border-[#e2e8f0]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-start">
            <div class="lg:col-span-4 space-y-3">
                <div class="text-xs font-mono text-[#0084ff] uppercase tracking-[0.2em] font-bold">
                    // 02 FILOSOFI & PRINSIP
                </div>
                <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-[#031b4d] uppercase">
                    Desain Berorientasi Manfaat
                </h2>
                <p class="text-[#5b6777] text-sm leading-relaxed pt-1">
                    Prinsip Swiss: kesederhanaan, presisi, kejelasan fungsi, dan kualitas jangka panjang.
                </p>
            </div>
            <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 text-sm text-[#5b6777]">
                <div class="p-5 sm:p-6 border border-[#e2e8f0] bg-[#f8fafc] rounded-sm space-y-2">
                    <div class="font-mono text-xs font-bold text-[#031b4d] uppercase tracking-wider flex items-center gap-2">
                        <span class="text-[#0084ff]">01.</span> Efisiensi & Kecepatan
                    </div>
                    <p class="leading-relaxed text-xs sm:text-sm">
                        Kami membangun aplikasi dengan performa tinggi dan bobot ringan, memastikan akses cepat tanpa hambatan di semua jaringan dan perangkat.
                    </p>
                </div>
                <div class="p-5 sm:p-6 border border-[#e2e8f0] bg-[#f8fafc] rounded-sm space-y-2">
                    <div class="font-mono text-xs font-bold text-[#031b4d] uppercase tracking-wider flex items-center gap-2">
                        <span class="text-[#0084ff]">02.</span> Kejelasan Visual
                    </div>
                    <p class="leading-relaxed text-xs sm:text-sm">
                        Menerapkan prinsip kesederhanaan Swiss: hierarki informasi yang teratur, tipografi terbaca jelas, dan eliminasi elemen yang tidak esensial.
                    </p>
                </div>
                <div class="p-5 sm:p-6 border border-[#e2e8f0] bg-[#f8fafc] rounded-sm space-y-2">
                    <div class="font-mono text-xs font-bold text-[#031b4d] uppercase tracking-wider flex items-center gap-2">
                        <span class="text-[#0084ff]">03.</span> Integrasi Berkelanjutan
                    </div>
                    <p class="leading-relaxed text-xs sm:text-sm">
                        Solusi yang dapat terus berkembang sejalan dengan pertumbuhan bisnis, sekolah, maupun administrasi desa tanpa perlu merombak ulang.
                    </p>
                </div>
                <div class="p-5 sm:p-6 border border-[#e2e8f0] bg-[#f8fafc] rounded-sm space-y-2">
                    <div class="font-mono text-xs font-bold text-[#031b4d] uppercase tracking-wider flex items-center gap-2">
                        <span class="text-[#0084ff]">04.</span> Dukungan Penuh
                    </div>
                    <p class="leading-relaxed text-xs sm:text-sm">
                        Dukungan teknis responsif dan pendampingan langsung untuk memastikan semua platform berjalan optimal setiap saat.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
