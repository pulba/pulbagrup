---
import { Image } from "astro:assets";
import favicon from "../assets/favicon.png";
---

<section class="relative border-b border-[#e2e8f0] bg-white overflow-hidden">
    {/* Subtle Architectural Grid Lines */}
    <div
        class="absolute inset-0 pointer-events-none opacity-[0.03]"
        style="background-size: 40px 40px; background-image: linear-gradient(to right, #031b4d 1px, transparent 1px), linear-gradient(to bottom, #031b4d 1px, transparent 1px);"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 sm:pt-16 pb-16 sm:pb-20 relative z-10">
        {/* Top Meta Bar */}
        <div class="flex flex-wrap items-center justify-between gap-4 pb-8 sm:pb-12 border-b border-[#e2e8f0] text-xs font-mono uppercase tracking-[0.18em] text-[#5b6777]">
            <div class="flex items-center gap-2.5">
                <span class="text-[#0084ff] font-bold">// 00</span>
                <span class="font-semibold text-[#031b4d]">PULBA DIGITAL ECOSYSTEM</span>
            </div>
            <div class="flex items-center gap-4 sm:gap-6 text-[11px] sm:text-xs">
                <span>EST. 2024</span>
                <span class="hidden sm:inline-block text-[#e2e8f0]">|</span>
                <span class="hidden sm:inline-block">INTERNATIONAL TYPOGRAPHIC STANDARD</span>
            </div>
        </div>

        {/* Main Hero Grid */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 pt-10 sm:pt-16 items-start">
            {/* Left / Top Headline Column */}
            <div class="lg:col-span-8 space-y-6 sm:space-y-8">
                {/* Brand Badge with Monogram */}
                <div class="inline-flex items-center gap-3 p-1.5 pr-4 bg-slate-50 border border-[#e2e8f0] rounded-full shadow-xs">
                    <Image
                        src={favicon}
                        alt="Pulba Monogram"
                        width={48}
                        height={48}
                        class="w-7 h-7 rounded-full object-cover border border-[#0084ff]/30 shadow-xs"
                    />
                    <span class="text-xs font-mono font-semibold tracking-wider text-[#031b4d] uppercase">
                        Presisi Teknis &bull; Desain Fungsional
                    </span>
                    <span class="h-1.5 w-1.5 rounded-full bg-[#0084ff]"></span>
                </div>

                <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-[-0.04em] text-[#031b4d] leading-[0.98] sm:leading-[0.95] uppercase">
                    Transformasi <br />
                    <span class="text-[#0084ff]">Digital</span> Terpadu.
                </h1>

                <p class="text-base sm:text-lg md:text-xl text-[#5b6777] font-normal leading-relaxed max-w-2xl">
                    Membangun ekosistem teknologi yang efisien, handal, dan estetik untuk kebutuhan bisnis, institusi pendidikan, pemerintahan desa, hingga kebutuhan akademik.
                </p>

                {/* Minimalist CTA Buttons */}
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 pt-2 sm:pt-4">
                    <a
                        href="#produk"
                        class="inline-flex items-center justify-center gap-3 px-7 sm:px-8 py-3.5 sm:py-4 bg-[#031b4d] text-white text-xs font-mono font-bold uppercase tracking-wider rounded-sm transition-all duration-200 hover:bg-[#0084ff] hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 group"
                    >
                        <span>Jelajahi 4 Platform</span>
                        <span class="font-mono transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
                    </a>
                    <a
                        href="https://wa.me/6281532094978"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-3 px-7 sm:px-8 py-3.5 sm:py-4 bg-white text-[#031b4d] text-xs font-mono font-bold uppercase tracking-wider rounded-sm border border-[#031b4d] transition-all duration-200 hover:bg-slate-50 hover:border-[#0084ff] hover:text-[#0084ff]"
                    >
                        <span>Konsultasi Proyek</span>
                        <span class="font-mono text-xs text-[#0084ff]">&nearr;</span>
                    </a>
                </div>
            </div>

            {/* Right Asymmetric Specification & Metric Box */}
            <div class="lg:col-span-4 border border-[#e2e8f0] bg-[#f8fafc] p-6 sm:p-8 rounded-sm space-y-6 sm:space-y-8">
                <div>
                    <div class="text-[11px] font-mono text-[#0084ff] uppercase tracking-[0.2em] font-bold mb-2 sm:mb-3">
                        // SPECIFICATION SUMMARY
                    </div>
                    <div class="space-y-3 sm:space-y-4 text-xs sm:text-sm text-[#5b6777]">
                        <p class="leading-relaxed">
                            Fokus pada arsitektur web modern, performa tinggi, dan pengalaman pengguna yang intuitif dengan pendekatan modularitas.
                        </p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 sm:gap-4 pt-4 sm:pt-6 border-t border-[#e2e8f0]">
                    <div class="p-4 bg-white border border-[#e2e8f0] rounded-sm">
                        <div class="text-2xl sm:text-3xl font-extrabold text-[#031b4d] font-mono">04</div>
                        <div class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-[#5b6777] mt-1">Platform Aktif</div>
                    </div>
                    <div class="p-4 bg-white border border-[#e2e8f0] rounded-sm">
                        <div class="text-2xl sm:text-3xl font-extrabold text-[#0084ff] font-mono">100%</div>
                        <div class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-[#5b6777] mt-1">Dedicated Support</div>
                    </div>
                </div>

                <div class="p-3.5 sm:p-4 bg-white border border-[#e2e8f0] rounded-sm flex items-center justify-between">
                    <div>
                        <div class="text-xs font-bold text-[#031b4d] uppercase tracking-wide">Infrastruktur</div>
                        <div class="text-[11px] text-[#5b6777] font-mono mt-0.5">High Performance Cloud</div>
                    </div>
                    <span class="text-xs font-mono text-[#0084ff] font-bold flex items-center gap-1.5">
                        <span class="h-2 w-2 rounded-full bg-[#0084ff] animate-pulse"></span>
                        READY
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>
