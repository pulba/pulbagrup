---
import { Image } from "astro:assets";
import logo from "../assets/favicon.png";
---

<header
    class="relative min-h-[80vh] flex items-center justify-center pt-32 pb-20 overflow-hidden"
>
    {/* Grid Background (Jaring-jaring) */}
    <div
        class="absolute inset-0 z-0 opacity-20 pointer-events-none"
        style="background-image: radial-gradient(circle at 2px 2px, rgba(99, 102, 241, 0.2) 1px, transparent 0); background-size: 40px 40px;"
    >
    </div>

    {/* Animated background elements */}
    <div
        class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-500/10 blur-[120px] rounded-full animate-pulse-slow"
    >
    </div>
    <div
        class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-pink-500/10 blur-[120px] rounded-full animate-pulse-slow [animation-delay:2s]"
    >
    </div>

    <div class="container mx-auto px-6 relative z-10 text-center">
        <div
            class="inline-flex items-center gap-2 px-4 py-2 mb-8 text-xs font-bold tracking-[0.2em] text-indigo-400 uppercase bg-indigo-500/5 rounded-full border border-indigo-500/20 backdrop-blur-sm"
        >
            <span class="relative flex h-2 w-2">
                <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"
                ></span>
                <span
                    class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"
                ></span>
            </span>
            Professional Digital Ecosystem
        </div>

        <div class="flex justify-center mb-8">
            <div class="relative group">
                <div
                    class="absolute -inset-4 bg-indigo-500/20 rounded-full blur-xl group-hover:bg-indigo-500/40 transition-all duration-500"
                >
                </div>
                <Image
                    src={logo}
                    alt="Pulba Grup Logo"
                    width={120}
                    height={120}
                    class="relative w-24 h-24 md:w-32 md:h-32 object-contain drop-shadow-2xl"
                />
            </div>
        </div>

        <h1
            class="text-7xl md:text-9xl font-extrabold tracking-tighter mb-8 leading-tight"
        >
            <span
                class="inline-block bg-clip-text text-transparent bg-gradient-to-b from-white via-white to-white/40"
            >
                Pulba
            </span>
            <span
                class="inline-block bg-clip-text text-transparent bg-gradient-to-tr from-indigo-400 to-indigo-600"
            >
                Grup
            </span>
        </h1>

        <p
            class="text-xl md:text-2xl text-slate-400 font-light max-w-3xl mx-auto leading-relaxed mb-12"
        >
            Membangun masa depan digital melalui <span
                class="text-white font-medium italic"
                >ekosistem solusi terintegrasi</span
            > untuk bisnis, pendidikan, dan pemberdayaan masyarakat.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-6">
            <a
                href="#produk"
                class="px-10 py-5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl transition-all duration-300 shadow-xl shadow-indigo-600/20 hover:shadow-indigo-600/40 hover:-translate-y-1"
            >
                Jelajahi Solusi
            </a>
            <a
                href="https://wa.me/6281532094978"
                class="px-10 py-5 bg-white/5 hover:bg-white/10 text-white font-bold rounded-2xl transition-all duration-300 border border-white/10 backdrop-blur-md"
            >
                Konsultasi Gratis
            </a>
        </div>
    </div>
</header>

<style>
    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.3;
            transform: scale(1);
        }
        50% {
            opacity: 0.6;
            transform: scale(1.1);
        }
    }
    .animate-pulse-slow {
        animation: pulse-slow 8s ease-in-out infinite;
    }
</style>
